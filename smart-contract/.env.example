# 钉钉智能合同连接器 —— 环境变量示例
# 复制为 .env 后填入真实值（server.js 通过 process.env 读取）

# ============================================================
# 数据来源选择（dws / sync / openapi，三选一）
#   dws    ：本机已登录 dws CLI 直连「智能合同」，零配置，【主路径 · 默认】
#   sync   ：连接流「同步调用地址」（方式一 · 备用，本项目已搁置，见 README）
#   openapi：企业内部应用 AppKey/Secret + 连接器 assetUri（方式二 · 备用）
#   留空时：只要本机 dws 可用就自动走 dws
#   演示数据：不填任何凭证且本机无 dws 时自动进入 demo
# ============================================================
DINGTALK_SOURCE=dws

# 【方式一 · 低代码 · 备用】连接流「同步调用地址」
# 在开发者后台「连接平台 -> 我的连接流」建流：触发事件选「子流程-当被调用时触发」，
# 执行动作选「官方连接器-智能合同-分页查询合同详情」（该连接器无独立的「查询合同列表」动作），
# 且动作入参 staffId 必须映射（如「流程参数-当前员工 UserId」），否则只会得到 success:false + 空 errorMsg。
# 打开触发事件的「同步调用开关」并【发布】后，复制地址填这里。
# 形如： https://connector.dingtalk.com/webhook/subflow/xxxxxxxx
DINGTALK_SYNC_URL=

# 【方式二 · OpenAPI 直连】企业内部应用的 AppKey / AppSecret（钉钉开发者后台 -> 应用基础信息）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# 「智能合同」官方连接器（连接平台）各执行动作的 connectAssetUri
# 在连接器详情 / 连接流节点中可复制，形如 dca://xxxx/action/XXXX
DINGTALK_CONNECTOR_LIST_URI=        # 分页查询合同详情（方式二必填，否则无法拉取实时数据）
DINGTALK_CONNECTOR_DETAIL_URI=      # 查询合同详情（可选）
DINGTALK_CONNECTOR_ARCHIVE_URI=     # 归档（可选，写操作）
DINGTALK_CONNECTOR_TRANSFER_URI=    # 转交（可选，写操作）
DINGTALK_CONNECTOR_COMPLETE_URI=    # 完结（可选，写操作）

# 后端监听端口（默认 8787）
PORT=8787

# ============================================================
# 方式三（dws）调优项 / 多组织，通常留空即可
# ============================================================
# 多组织：dws 一个账号可登录多个钉钉组织，`dws profile list` 可查（每个组织是一个 profile）。
# 新组织需要你自己在终端执行 `dws auth login` 完成扫码授权（登录属于身份动作，我不代做）。
# 登录后页面右上角出现组织下拉：一次只呈现一个组织的台账，列表缓存/详情缓存/补全台账均按 corpId 分键；
# 选定但未登录的组织会直接报错，不会静默回退成当前组织的数据。
#
# 关闭「后台逐合同补全」（首次返回更快，但台账里的起止日期/相对方需打开详情才补全）
# ENRICH_OFF=1
# 仅补全前 N 份合同（默认 0 = 全部；数百份全量约 1~2 分钟）
# ENRICH_MAX=200
# 我方主体别名：避免把「自己」解析成相对方。两种语法——
#   OWN_COMPANY=A,B                    → 全局别名（对所有组织生效）
#   OWN_COMPANY=corpId1=A,B;corpId2=C  → 按组织别名（推荐：A 组织的我方主体在 B 组织可能就是相对方）
# 各组织自身的 corpName 会自动算作我方主体，所以第二个组织通常什么都不用配。
# OWN_COMPANY=dingexamplecorp000000000000000001=北京云帆科技集团有限公司,安捷(北京)汽车服务有限公司,云帆

# ============================================================
# 本机落盘文件（无需配置，删除即重建；都不含凭证，也都不回写钉钉）
#   .enrich-ledger.json     补全到的起止日期/相对方/用印公司/用途，重启与缓存过期后贴回，避免到期统计清零
#   .contract-classes.json  人工改判的合同分类 `{ corpId: { cid: { cat, company } } }`
# ============================================================

